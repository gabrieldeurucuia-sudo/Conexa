{
  "name": "vibe-hub",
  "version": "1.0.0",
  "description": "Rede Social Vibe Hub - Conecte experiências, compartilhe vibrações",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon --exec node --experimental-modules src/index.js",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "migrate": "npm run migrate:up",
    "migrate:up": "knex migrate:latest",
    "migrate:down": "knex migrate:rollback",
    "lint": "eslint src",
    "format": "prettier --write src"
  },
  "keywords": [
    "social-network",
    "vibe",
    "community",
    "real-time"
  ],
  "author": "Vibe Hub Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "express-cors": "^0.1.0",
    "dotenv": "^16.3.1",
    "jsonwebtoken": "^9.1.2",
    "bcryptjs": "^2.4.3",
    "pg": "^8.11.3",
    "redis": "^4.6.12",
    "socket.io": "^4.7.2",
    "joi": "^17.11.0",
    "axios": "^1.6.2"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/jest": "^29.5.11",
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1"
  }
}
